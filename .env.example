# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored and must never be committed.

# --- Garmin Connect credentials (used for syncing activities) ---
GARMIN_EMAIL=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password

# --- Anthropic API key for the AI coach (https://console.anthropic.com/) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Where cached Garmin session tokens are stored ---
GARMIN_TOKEN_DIR=./data/garmin_tokens

# --- PostgreSQL connection string ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# This matches the role + database created by scripts/setup_postgres.sql.
DATABASE_URL=postgresql://coach:coach_local_dev@localhost:5432/garmin_coach
